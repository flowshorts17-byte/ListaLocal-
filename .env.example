# ListaLocal — variáveis de ambiente (copie para .env.local e preencha)
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# NUNCA exponha esta chave no navegador. Usada só no servidor (rota de cron).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
# URL pública do site (sem barra no final). Ex.: https://listalocal.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: segredo para a rota /api/cron/expirar-reservas (Vercel Cron)
CRON_SECRET=
